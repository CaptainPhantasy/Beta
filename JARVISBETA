Remember: You're a full AI assistant with vision capabilities, not just a visual analysis tool.`;

        // Initialize audio context for mobile - IMPROVED VERSION
        function initializeAudio() {
            if (audioInitialized) return true;
            
            try {
                // Create audio context with options for mobile compatibility
                audioContext = new (window.AudioContext || window.webkitAudioContext)({
                    latencyHint: 'interactive',
                    sampleRate: 44100
                });
                
                // Critical for iOS - play and immediately pause a silent sound
                const unlockAudio = () => {
                    const oscillator = audioContext.createOscillator();
                    const gainNode = audioContext.createGain();
                    gainNode.gain.value = 0.001; // Nearly silent
                    oscillator.connect(gainNode);
                    gainNode.connect(audioContext.destination);
                    oscillator.start(0);
                    oscillator.stop(0.001);
                    
                    // Remove event listeners once unlocked
                    document.removeEventListener('touchstart', unlockAudio);
                    document.removeEventListener('touchend', unlockAudio);
                    document.removeEventListener('click', unlockAudio);
                };
                
                // Add these event listeners to unlock audio
                document.addEventListener('touchstart', unlockAudio, { once: true });
                document.addEventListener('touchend', unlockAudio, { once: true });
                document.addEventListener('click', unlockAudio, { once: true });
                
                // Resume audio context (important for iOS)
                if (audioContext.state === 'suspended') {
                    audioContext.resume();
                }
                
                audioInitialized = true;
                console.log("Audio context initialized successfully");
                showStatusFloat("Audio system ready", 2000);
                return true;
            } catch (error) {
                console.error("Audio context initialization failed:", error);
                showStatusFloat("Audio initialization failed", 3000);
                return false;
            }
        }

        // Test audio function
        function testAudio() {
            initializeAudio();
            
            // Test with a simple beep
            if (audioContext) {
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                oscillator.frequency.setValueAtTime(800, audioContext.currentTime);
                gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);
                
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.5);
                
                showStatusFloat("Audio test complete", 2000);
            }
            
            // Test speech synthesis
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance("Audio test successful, Sir.");
                utterance.volume = 1.0;
                utterance.rate = 1.0;
                utterance.pitch = 1.0;
                
                speechSynthesis.cancel();
                speechSynthesis.speak(utterance);
            }
        }

        // Set maximum volume
        function setMaxVolume() {
            // Set media volume to maximum
            if ('mediaSession' in navigator) {
                navigator.mediaSession.setActionHandler('volumechange', () => {
                    // Handle volume changes
                });
            }
            
            showStatusFloat("Volume set to maximum", 2000);
        }

        function initializeApp() {
            console.log("Initializing JARVIS...");
            checkBrowserSupport();
            setupEventListeners();
            checkApiKeys();
            setupVideoModes();
            setupVoiceSelection();
            setupCollapsible();
            setupAlwaysOnControls();
            setupAudioControls();
            updatePermissionStatus();
            
            // Initialize audio on first user interaction
            document.addEventListener('click', initializeAudio, { once: true });
            document.addEventListener('touchstart', initializeAudio, { once: true });
            
            // Preload speech synthesis voices for faster response
            if ('speechSynthesis' in window) {
                speechSynthesis.getVoices();
                window.speechSynthesis.onvoiceschanged = () => {
                    console.log("Speech synthesis voices loaded");
                };
            }
        }

        function setupAudioControls() {
            audioTestButton.addEventListener('click', testAudio);
            volumeButton.addEventListener('click', setMaxVolume);
        }

        function updatePermissionStatus() {
            if (speechPermissionGranted && isMicOn && isListeningActive) {
                permissionStatus.textContent = '🎤 Listening actively';
                permissionStatus.classList.add('listening');
                permissionStatus.classList.remove('granted');
            } else if (speechPermissionGranted && isMicOn) {
                permissionStatus.textContent = '🎤 Ready to listen';
                permissionStatus.classList.add('granted');
                permissionStatus.classList.remove('listening');
            } else if (speechPermissionGranted) {
                permissionStatus.textContent = '🎤 Granted (Off)';
                permissionStatus.classList.remove('granted', 'listening');
            } else {
                permissionStatus.textContent = '🎤 Not granted';
                permissionStatus.classList.remove('granted', 'listening');
            }
        }

        function checkBrowserSupport() {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                showStatusFloat("Your browser doesn't support camera/microphone access. Please use Chrome, Firefox, or Safari.", 10000);
                startCameraButton.disabled = true;
                return false;
            }
            
            if (!recognition) {
                showStatusFloat("Speech recognition not supported. Limited functionality available.", 7000);
                return false;
            } else {
                setupSpeechRecognition();
            }
            
            return true;
        }

        function setupSpeechRecognition() {
            if (!recognition) return;
            
            recognition.continuous = true;
            recognition.interimResults = true;
            recognition.lang = 'en-US';
            
            recognition.onstart = () => {
                isListeningActive = true;
                speechPermissionGranted = true;
                micPermissionAsked = true;  // Mark that we've successfully asked for permission
                recognitionAttemptsCount = 0; // Reset the counter when successfully started
                console.log("Speech recognition started successfully");
                showStatusFloat("Speech recognition active", 2000);
                updatePermissionStatus();
                
                if (analysisMode === 'wakeword') {
                    wakeWordIndicator.classList.add('visible');
                    updateWakeWordText();
                }
            };
            
            recognition.onresult = (event) => {
                const results = Array.from(event.results);
                const latestResult = results[results.length - 1];
                
                if (latestResult && latestResult.isFinal) {
                    const transcript = latestResult[0].transcript.toLowerCase().trim();
                    const currentTime = Date.now();
                    
                    if (currentTime - lastSpeechTime < 1000) return;
                    lastSpeechTime = currentTime;
                    
                    console.log("Final transcript:", transcript);
                    
                    if (awaitingCommand) {
                        clearTimeout(commandTimeout);
                        awaitingCommand = false;
                        listeningIndicator.classList.remove('visible');
                        currentTranscript = latestResult[0].transcript;
                        showStatusFloat(`Command: "${currentTranscript}"`);
                        handleAIInteraction(currentTranscript);
                    } else if (analysisMode === 'wakeword' && transcript.includes(wakeWord.toLowerCase())) {
                        triggerWakeWord();
                    }
                }
            };
            
            recognition.onerror = (event) => {
                console.error("Speech recognition error:", event.error);
                
                if (event.error === 'not-allowed') {
                    speechPermissionGranted = false;
                    showStatusFloat("Microphone permission denied. Please allow microphone access.", 5000);
                } else if (event.error === 'no-speech') {
                    console.log("No speech detected (normal for continuous recognition)");
                } else if (event.error === 'audio-capture') {
                    showStatusFloat("Microphone error. Please check your microphone.", 5000);
                } else {
                    showStatusFloat(`Speech recognition error: ${event.error}`, 3000);
                }
                
                updatePermissionStatus();
                
                // Be more careful about restarting recognition after errors
                if (event.error !== 'not-allowed' && event.error !== 'aborted' && 
                    analysisMode === 'wakeword' && isMicOn && micPermissionAsked) {
                    
                    // Only try to restart if we haven't attempted too many times
                    if (recognitionAttemptsCount < 3) {
                        setTimeout(() => {
                            if (analysisMode === 'wakeword' && isMicOn && !isListeningActive && micPermissionAsked) {
                                startContinuousListening();
                                recognitionAttemptsCount++;
                            }
                        }, 3000);
                    } else {
                        console.log("Too many recognition restart attempts. Waiting for user action.");
                        showStatusFloat("Voice recognition paused. Click microphone to restart.", 5000);
                    }
                }
            };
            
            recognition.onend = () => {
                isListeningActive = false;
                console.log("Speech recognition ended");
                updatePermissionStatus();
                
                // Only restart if we're in wake word mode, mic is on, permissions granted,
                // and we haven't restarted too recently
                const currentTime = Date.now();
                if (analysisMode === 'wakeword' && isMicOn && speechPermissionGranted && 
                    micPermissionAsked && 
                    (currentTime - lastRecognitionRestartTime > recognitionRestartCooldown) && 
                    recognitionAttemptsCount < 3) {
                    
                    lastRecognitionRestartTime = currentTime;
                    
                    setTimeout(() => {
                        if (analysisMode === 'wakeword' && isMicOn && !isListeningActive && micPermissionAsked) {
                            startContinuousListening();
                        }
                    }, 1000);
                }
            };
        }

        function startContinuousListening() {
            // Don't try to start if already listening
            if (!recognition || isListeningActive || !isMicOn) {
                return;
            }
            
            // Don't restart too often, use cooldown
            const currentTime = Date.now();
            if (currentTime - lastRecognitionRestartTime < recognitionRestartCooldown) {
                console.log("Recognition restart on cooldown, waiting...");
                return;
            }
            
            lastRecognitionRestartTime = currentTime;
            
            try {
                console.log("Starting continuous speech recognition...");
                recognition.start();
            } catch (e) {
                console.error("Failed to start speech recognition:", e);
                
                if (e.name === 'InvalidStateError') {
                    // Recognition is already running or in a state we can't start
                    isListeningActive = true;
                    updatePermissionStatus();
                } else {
                    showStatusFloat("Failed to start speech recognition. Try reloading.", 5000);
                    recognitionAttemptsCount++;
                }
            }
        }

        function stopContinuousListening() {
            clearTimeout(commandTimeout);
            awaitingCommand = false;
            
            if (isListeningActive && recognition) {
                try {
                    recognition.stop();
                } catch (e) {
                    console.error("Error stopping speech recognition:", e);
                }
            }
            
            isListeningActive = false;
            wakeWordIndicator.classList.remove('visible');
            listeningIndicator.classList.remove('visible');
            updatePermissionStatus();
        }

        function triggerWakeWord() {
            // Initialize audio on wake word detection
            initializeAudio();
            
            showStatusFloat("Wake word detected!");
            wakeWordIndicator.classList.add('triggered');
            wakeWordText.textContent = 'Wake word detected! What can I help you with?';
            
            awaitingCommand = true;
            listeningIndicator.classList.add('visible');
            
            clearTimeout(commandTimeout);
            commandTimeout = setTimeout(() => {
                if (awaitingCommand) {
                    awaitingCommand = false;
                    listeningIndicator.classList.remove('visible');
                    showStatusFloat("No command heard. How may I assist you, Sir?");
                    handleAIInteraction("Hello JARVIS");
                }
            }, 8000);
            
            setTimeout(() => {
                wakeWordIndicator.classList.remove('triggered');
                updateWakeWordText();
            }, 3000);
        }

        function updateWakeWordText() {
            if (isMicOn && speechPermissionGranted) {
                wakeWordText.textContent = `Listening for "${wakeWord}"...`;
            } else {
                wakeWordText.textContent = `Microphone needed for "${wakeWord}"`;
            }
        }

        function setupAlwaysOnControls() {
            cameraToggle.addEventListener('click', toggleCamera);
            micToggle.addEventListener('click', toggleMicrophone);
        }

        function toggleCamera() {
            if (isCameraOn) {
                if (mediaStream) {
                    const videoTracks = mediaStream.getVideoTracks();
                    videoTracks.forEach(track => {
                        track.stop();
                        mediaStream.removeTrack(track);
                    });
                }
                
                isCameraOn = false;
                cameraToggle.classList.remove('active');
                cameraToggle.classList.add('off');
                showStatusFloat("Camera disabled");
            } else {
                enableCamera();
            }
        }

        async function enableCamera() {
            try {
                const videoStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: "environment",
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    }
                });
                
                if (mediaStream) {
                    videoStream.getVideoTracks().forEach(track => {
                        mediaStream.addTrack(track);
                    });
                } else {
                    mediaStream = videoStream;
                }
                
                cameraFeed.srcObject = mediaStream;
                await cameraFeed.play();
                
                isCameraOn = true;
                cameraToggle.classList.remove('off');
                cameraToggle.classList.add('active');
                showStatusFloat("Camera enabled");
                
                setTimeout(() => {
                    lastFrameData = captureFrameForMotionDetection();
                }, 1000);
            } catch (err) {
                console.error("Camera error:", err);
                showStatusFloat("Failed to enable camera");
            }
        }

        function toggleMicrophone() {
            if (isMicOn) {
                stopContinuousListening();
                isMicOn = false;
                micToggle.classList.remove('active');
                micToggle.classList.add('off');
                showStatusFloat("Microphone disabled");
                updatePermissionStatus();
            } else {
                isMicOn = true;
                micToggle.classList.remove('off');
                micToggle.classList.add('active');
                showStatusFloat("Microphone enabled");
                recognitionAttemptsCount = 0; // Reset counter when manually enabling
                
                if (analysisMode === 'wakeword') {
                    startContinuousListening();
                }
                
                updatePermissionStatus();
            }
        }

        async function loadPremiumVoices() {
            if (!elevenLabsApiKey) {
                showStatusFloat("ElevenLabs API key required for premium voices. Using browser TTS.", 3000);
                return;
            }
            
            try {
                loadVoicesButton.disabled = true;
                loadVoicesButton.textContent = 'Loading...';
                
                const response = await fetch('https://api.elevenlabs.io/v1/voices', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'xi-api-key': elevenLabsApiKey
                    }
                });
                
                if (!response.ok) {
                    throw new Error(`API Error ${response.status}`);
                }
                
                const data = await response.json();
                availableVoices = data.voices || [];
                
                voiceGrid.innerHTML = '';
                
                // Add browser TTS first
                const browserCard = document.createElement('div');
                browserCard.className = 'voice-card active';
                browserCard.setAttribute('data-voice-id', 'browser');
                browserCard.setAttribute('data-voice-name', 'Browser TTS');
                browserCard.innerHTML = `
                    <div class="font-semibold text-sm text-white mb-1">🤖 Browser Voice</div>
                    <div class="text-xs text-gray-400">Built-in speech synthesis</div>
                `;
                browserCard.addEventListener('click', () => selectVoice('browser', 'Browser TTS', 'Built-in speech synthesis'));
                voiceGrid.appendChild(browserCard);
                
                // Add premium voices
                const premiumVoices = availableVoices.slice(0, 7);
                
                premiumVoices.forEach((voice) => {
                    const voiceCard = document.createElement('div');
                    voiceCard.className = 'voice-card';
                    voiceCard.setAttribute('data-voice-id', voice.voice_id);
                    voiceCard.setAttribute('data-voice-name', voice.name);
                    
                    const emoji = getVoiceEmoji(voice);
                    const description = voice.description || 'Premium voice';
                    const shortDesc = description.length > 30 ? description.substring(0, 30) + '...' : description;
                    
                    voiceCard.innerHTML = `
                        <div class="font-semibold text-sm text-white mb-1">${emoji} ${voice.name}</div>
                        <div class="text-xs text-gray-400" title="${description}">${shortDesc}</div>
                    `;
                    
                    voiceCard.addEventListener('click', () => selectVoice(voice.voice_id, voice.name, description));
                    voiceGrid.appendChild(voiceCard);
                });
                
                showStatusFloat(`Loaded ${premiumVoices.length + 1} voices!`, 3000);
                loadVoicesButton.textContent = 'Voices Loaded ✓';
            } catch (error) {
                console.error("Error loading voices:", error);
                showStatusFloat(`Error loading premium voices. Using browser TTS.`, 3000);
                loadVoicesButton.textContent = 'Retry Load Voices';
                loadVoicesButton.disabled = false;
            }
        }

        function getVoiceEmoji(voice) {
            const name = voice.name.toLowerCase();
            if (name.includes('rachel')) return '👩';
            if (name.includes('adam')) return '👨';
            if (name.includes('antoni')) return '🎯';
            return '🎭';
        }

        function selectVoice(voiceId, voiceName, description) {
            document.querySelectorAll('.voice-card').forEach(card => {
                card.classList.remove('active');
            });
            
            const selectedCard = document.querySelector(`[data-voice-id="${voiceId}"]`);
            if (selectedCard) {
                selectedCard.classList.add('active');
            }
            
            selectedVoiceId = voiceId;
            selectedVoiceName = voiceName;
            useBrowserTTS = (voiceId === 'browser');
            voiceDescription.textContent = `${voiceName}: ${description}`;
            showStatusFloat(`Voice: ${voiceName}`, 2000);
        }

        function setupCollapsible() {
            voiceToggle.addEventListener('click', () => {
                const chevron = voiceToggle.querySelector('.chevron');
                const isExpanded = voiceContent.classList.contains('expanded');
                
                if (isExpanded) {
                    voiceContent.classList.remove('expanded');
                    chevron.classList.remove('rotated');
                } else {
                    voiceContent.classList.add('expanded');
                    chevron.classList.add('rotated');
                }
            });
        }

        function setupVoiceSelection() {
            loadVoicesButton.addEventListener('click', loadPremiumVoices);
        }

        function setupVideoModes() {
            const modeButtons = [manualModeButton, intervalModeButton, motionModeButton, wakeWordModeButton];
            const modes = ['manual', 'interval', 'motion', 'wakeword'];
            const descriptions = {
                manual: 'Manual analysis mode - Press C to capture',
                interval: 'Auto-analyzes every 15 seconds',
                motion: 'Analyzes when movement detected',
                wakeword: `Say "${wakeWord}" to interact`
            };
            
            modeButtons.forEach((button, index) => {
                button.addEventListener('click', () => {
                    modeButtons.forEach(btn => btn.classList.remove('active'));
                    button.classList.add('active');
                    
                    const newMode = modes[index];
                    setAnalysisMode(newMode);
                    modeDescription.textContent = descriptions[newMode];
                    showStatusFloat(`Mode: ${newMode}`, 2000);
                });
            });
        }

        function setAnalysisMode(mode) {
            if (intervalId) {
                clearInterval(intervalId);
                intervalId = null;
            }
            
            if (analysisMode === 'wakeword') {
                stopContinuousListening();
            }
            
            analysisMode = mode;
            
            switch (mode) {
                case 'manual':
                    break;
                case 'interval':
                    // Changed from 5 seconds to 15 seconds
                    intervalId = setInterval(() => {
                        if (!isAnalyzing && !isSpeaking && isCameraOn) {
                            handleAIInteraction('analyze the current scene', true);
                        }
                    }, 15000);
                    break;
                case 'motion':
                    startMotionDetection();
                    break;
                case 'wakeword':
                    recognitionAttemptsCount = 0; // Reset counter when changing to this mode
                    if (isMicOn) {
                        startContinuousListening();
                    }
                    break;
            }
        }

                function startMotionDetection() {
            const motionDetectionInterval = setInterval(() => {
                if (analysisMode !== 'motion' || !isCameraOn) {
                    clearInterval(motionDetectionInterval);
                    return;
                }
                
                const currentFrameData = captureFrameForMotionDetection();
                
                if (currentFrameData && lastFrameData) {
                    const motionDetected = detectMotion(lastFrameData, currentFrameData);
                    
                    if (motionDetected && !isAnalyzing && !isSpeaking) {
                        motionIndicator.classList.add('active');
                        setTimeout(() => motionIndicator.classList.remove('active'), 1000);
                        handleAIInteraction('I detect movement in your environment', true);
                    }
                }
                
                lastFrameData = currentFrameData;
            }, 500);
        }

        function captureFrameForMotionDetection() {
            if (!isCameraOn || !cameraFeed.videoWidth) return null;
            
            const context = motionCanvas.getContext('2d');
            motionCanvas.width = 320;
            motionCanvas.height = 240;
            context.drawImage(cameraFeed, 0, 0, 320, 240);
            
            return context.getImageData(0, 0, 320, 240);
        }

        function detectMotion(imageData1, imageData2) {
            const data1 = imageData1.data;
            const data2 = imageData2.data;
            let diffPixels = 0;
            
            for (let i = 0; i < data1.length; i += 4) {
                const diff = Math.abs(data1[i] - data2[i]) + 
                             Math.abs(data1[i+1] - data2[i+1]) + 
                             Math.abs(data1[i+2] - data2[i+2]);
                             
                if (diff > motionThreshold) {
                    diffPixels++;
                }
            }
            
            return diffPixels > motionPixelThreshold;
        }

        function showStatusFloat(message, duration = 3000) {
            statusFloat.textContent = message;
            statusFloat.classList.remove('hidden-init');
            statusFloat.classList.add('visible');
            
            setTimeout(() => {
                statusFloat.classList.remove('visible');
                statusFloat.classList.add('hidden-init');
            }, duration);
        }

        function setupEventListeners() {
            startCameraButton.addEventListener('click', startCamera);
            saveApiKeys.addEventListener('click', handleSaveApiKeys);
            getApiKeyHelp.addEventListener('click', () => {
                window.open('https://aistudio.google.com/', '_blank');
            });
            
            geminiApiKeyInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') handleSaveApiKeys();
            });
            
            wakeWordInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') handleSaveApiKeys();
            });
        }

        function checkApiKeys() {
