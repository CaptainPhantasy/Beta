<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>JARVIS - AI Vision Assistant by Legacy AI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            overscroll-behavior: none;
            background: linear-gradient(135deg, #0D47A1 0%, #1B5E20 50%, #2E7D32 100%);
            min-height: 100vh;
        }
        
        .video-container {
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            background: linear-gradient(45deg, #4CAF50 0%, #2196F3 100%);
            padding: 3px;
        }
        
        #cameraFeed {
            transform: scaleX(-1);
            width: 100%;
            height: auto;
            border-radius: 21px;
            background: #000;
        }
        
        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }
        
        .wake-word-indicator {
            position: fixed;
            top: 80px;
            left: 50%;
            transform: translateX(-50%);
            padding: 16px 24px;
            background: rgba(76, 175, 80, 0.9);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            color: white;
            font-size: 16px;
            font-weight: 600;
            z-index: 95;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 2px solid rgba(139, 195, 74, 0.3);
        }
        
        .wake-word-indicator.visible {
            opacity: 1;
            transform: translateX(-50%) scale(1.05);
        }
        
        .wake-word-indicator.triggered {
            background: rgba(118, 255, 3, 0.9);
            border-color: rgba(118, 255, 3, 0.5);
            animation: wakeWordPulse 0.6s ease-out;
        }
        
        .listening-indicator {
            position: fixed;
            bottom: 120px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 20px;
            background: rgba(33, 150, 243, 0.9);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            color: white;
            font-size: 14px;
            font-weight: 500;
            z-index: 90;
            opacity: 0;
            transition: all 0.3s ease;
            border: 2px solid rgba(100, 181, 246, 0.3);
        }
        
        .listening-indicator.visible {
            opacity: 1;
        }
        
        .status-float {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            padding: 12px 24px;
            background: rgba(27, 94, 32, 0.9);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            color: white;
            font-size: 14px;
            font-weight: 500;
            z-index: 100;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(76, 175, 80, 0.3);
        }
        
        .status-float.visible {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
        
        .status-float.hidden-init {
            transform: translateX(-50%) translateY(-30px);
        }
        
        .always-on-controls {
            position: fixed;
            top: 20px;
            right: 20px;
            display: flex;
            gap: 8px;
            z-index: 90;
        }
        
        .control-button {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(76, 175, 80, 0.2);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(139, 195, 74, 0.3);
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .control-button.active {
            background: rgba(118, 255, 3, 0.3);
            border-color: rgba(118, 255, 3, 0.5);
            box-shadow: 0 0 15px rgba(118, 255, 3, 0.4);
        }
        
        .control-button.off {
            background: rgba(121, 85, 72, 0.3);
            border-color: rgba(121, 85, 72, 0.5);
        }
        
        .tab-container {
            display: flex;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            padding: 4px;
            margin-bottom: 16px;
        }
        
        .tab-button {
            flex: 1;
            padding: 12px 8px;
            text-align: center;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
            color: rgba(255, 255, 255, 0.6);
            border: none;
            background: transparent;
        }
        
        .tab-button.active {
            background: linear-gradient(135deg, #4CAF50 0%, #2196F3 100%);
            color: white;
            box-shadow: 0 4px 16px rgba(76, 175, 80, 0.3);
        }
        
        .voice-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 16px;
        }
        
        .voice-card {
            padding: 12px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }
        
        .voice-card.active {
            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
            border-color: rgba(76, 175, 80, 0.5);
            transform: scale(1.02);
        }
        
        .voice-card:hover {
            background: rgba(255, 255, 255, 0.08);
            transform: scale(1.02);
        }
        
        .voice-card.active:hover {
            transform: scale(1.02);
        }
        
        .response-card {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 16px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            position: relative;
            overflow: hidden;
        }
        
        .response-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #4CAF50 0%, #2196F3 100%);
        }
        
        .voice-waveform {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 3px;
            height: 20px;
        }
        
        .wave-bar {
            width: 3px;
            background: linear-gradient(180deg, #76FF03 0%, #4CAF50 100%);
            border-radius: 2px;
            animation: wave 1.5s ease-in-out infinite;
        }
        
        .wave-bar:nth-child(1) { height: 8px; animation-delay: 0s; }
        .wave-bar:nth-child(2) { height: 16px; animation-delay: 0.1s; }
        .wave-bar:nth-child(3) { height: 12px; animation-delay: 0.2s; }
        .wave-bar:nth-child(4) { height: 20px; animation-delay: 0.3s; }
        .wave-bar:nth-child(5) { height: 14px; animation-delay: 0.4s; }
        
        .permission-status {
            position: fixed;
            bottom: 20px;
            right: 20px;
            padding: 8px 16px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            color: white;
            font-size: 12px;
            z-index: 80;
            opacity: 0.7;
        }
        
        .permission-status.granted {
            background: rgba(76, 175, 80, 0.2);
            border: 1px solid rgba(76, 175, 80, 0.3);
        }
        
        .permission-status.listening {
            background: rgba(33, 150, 243, 0.2);
            border: 1px solid rgba(33, 150, 243, 0.3);
            animation: pulse 2s infinite;
        }
        
        .motion-indicator {
            position: absolute;
            top: 16px;
            right: 16px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #76FF03;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .motion-indicator.active {
            opacity: 1;
            animation: pulse 1s infinite;
        }
        
        .speaking-indicator {
            position: absolute;
            bottom: 16px;
            left: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: rgba(76, 175, 80, 0.9);
            color: white;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .speaking-indicator.active {
            opacity: 1;
        }
        
        .collapsible-section {
            background: rgba(255, 255, 255, 0.02);
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            margin-bottom: 16px;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        
        .collapsible-header {
            padding: 16px 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .collapsible-content {
            padding: 0 20px;
            max-height: 0;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .collapsible-content.expanded {
            padding: 20px;
            max-height: 500px;
        }
        
        .chevron {
            transition: transform 0.3s ease;
        }
        
        .chevron.rotated {
            transform: rotate(180deg);
        }
        
        .footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 20px;
            text-align: center;
            background: rgba(27, 94, 32, 0.9);
            backdrop-filter: blur(20px);
            border-top: 1px solid rgba(76, 175, 80, 0.3);
        }
        
        .footer a {
            color: #8BC34A;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s ease;
        }
        
        .footer a:hover {
            color: #76FF03;
        }

        .audio-controls {
            position: fixed;
            bottom: 60px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 8px;
            z-index: 90;
            opacity: 0.8;
        }

        .audio-button {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(76, 175, 80, 0.3);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(139, 195, 74, 0.5);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .audio-button:hover {
            background: rgba(118, 255, 3, 0.4);
            border-color: rgba(118, 255, 3, 0.7);
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        
        @keyframes wave {
            0%, 100% { transform: scaleY(1); }
            50% { transform: scaleY(0.3); }
        }
        
        @keyframes wakeWordPulse {
            0% { transform: translateX(-50%) scale(1.05); }
            50% { transform: translateX(-50%) scale(1.15); }
            100% { transform: translateX(-50%) scale(1.05); }
        }
        
        .gradient-text {
            background: linear-gradient(135deg, #4CAF50 0%, #2196F3 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .api-key-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(20px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 200;
            padding: 20px;
        }
        
        .api-key-modal.hidden { display: none; }
        
        /* Mobile optimizations */
        @media (max-width: 768px) {
            .always-on-controls {
                right: 10px;
                top: 70px;
            }
            
            .control-button {
                width: 40px;
                height: 40px;
            }
            
            .voice-grid {
                grid-template-columns: 1fr;
            }
            
            .wake-word-indicator {
                top: 70px;
                font-size: 14px;
                padding: 12px 20px;
            }
            
            .permission-status {
                bottom: 80px;
                right: 10px;
                font-size: 10px;
            }
            
            .footer {
                padding: 15px;
                font-size: 14px;
            }

            .audio-controls {
                bottom: 120px;
            }
        }
        
        .custom-scroll::-webkit-scrollbar {
            width: 4px;
        }
        
        .custom-scroll::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 2px;
        }
        
        .custom-scroll::-webkit-scrollbar-thumb {
            background: rgba(76, 175, 80, 0.5);
            border-radius: 2px;
        }
        
        .legacy-logo {
            display: inline-block;
            font-weight: 800;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #76FF03 0%, #4CAF50 50%, #2196F3 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="min-h-screen">

    <!-- Always-On Controls -->
    <div class="always-on-controls">
        <div id="cameraToggle" class="control-button active" title="Camera On/Off">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
        </div>
        <div id="micToggle" class="control-button active" title="Microphone On/Off">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>
            </svg>
        </div>
    </div>

    <!-- Audio Controls -->
    <div class="audio-controls">
        <div id="audioTestButton" class="audio-button" title="Test Audio">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5 8h4l3-3V7a8 8 0 000 16v-2l-3-3H5a2 2 0 01-2-2V10a2 2 0 012-2z"></path>
            </svg>
        </div>
        <div id="volumeButton" class="audio-button" title="Max Volume">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M9 12l2 2 4-4"></path>
            </svg>
        </div>
    </div>

    <!-- Permission Status -->
    <div id="permissionStatus" class="permission-status">
        🎤 Mic: Checking...
    </div>

    <!-- Wake Word Indicator -->
    <div id="wakeWordIndicator" class="wake-word-indicator">
        <div class="flex items-center gap-2">
            <div class="voice-waveform">
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
            </div>
            <span id="wakeWordText">Listening for "Hey JARVIS"...</span>
        </div>
    </div>

    <!-- Listening Indicator -->
    <div id="listeningIndicator" class="listening-indicator">
        <div class="voice-waveform">
            <div class="wave-bar"></div>
            <div class="wave-bar"></div>
            <div class="wave-bar"></div>
            <div class="wave-bar"></div>
            <div class="wave-bar"></div>
        </div>
        <span>Listening for command...</span>
    </div>

    <!-- Floating Status -->
    <div id="statusFloat" class="status-float hidden-init"></div>

    <!-- API Key Modal -->
    <div id="apiKeyModal" class="api-key-modal">
        <div class="glass-card p-8 max-w-md w-full">
            <h2 class="text-2xl font-bold gradient-text mb-2 text-center">JARVIS System Setup</h2>
            <p class="text-gray-400 text-sm text-center mb-6">by <span class="legacy-logo">Legacy AI</span></p>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Gemini API Key (Required)</label>
                    <input id="geminiApiKeyInput" type="password" placeholder="AIza..." 
                           class="w-full p-4 bg-rgba-255-255-255-0.05 text-white rounded-xl border border-rgba-255-255-255-0.1 focus:border-green-400 focus:outline-none transition-colors">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">ElevenLabs API Key (Optional - fallback to browser TTS)</label>
                    <input id="elevenLabsApiKeyInput" type="password" placeholder="sk_..." 
                           class="w-full p-4 bg-rgba-255-255-255-0.05 text-white rounded-xl border border-rgba-255-255-255-0.1 focus:border-green-400 focus:outline-none transition-colors">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Wake Word (default: "Hey JARVIS")</label>
                    <input id="wakeWordInput" type="text" placeholder="Hey JARVIS" value="Hey JARVIS"
                           class="w-full p-4 bg-rgba-255-255-255-0.05 text-white rounded-xl border border-rgba-255-255-255-0.1 focus:border-green-400 focus:outline-none transition-colors">
                </div>
                <div class="flex gap-3 pt-4">
                    <button id="saveApiKeys" class="flex-1 bg-gradient-to-r from-green-500 to-green-600 text-white font-semibold py-3 px-6 rounded-xl hover:from-green-600 hover:to-green-700 transition-all">
                        Initialize JARVIS
                    </button>
                    <button id="getApiKeyHelp" class="flex-1 bg-rgba-255-255-255-0.1 text-white font-semibold py-3 px-6 rounded-xl hover:bg-rgba-255-255-255-0.2 transition-all">
                        Get Gemini Key
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Container -->
    <div class="min-h-screen px-4 py-6 pb-24">
        
        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold gradient-text mb-2">J.A.R.V.I.S.</h1>
            <p class="text-gray-400 text-lg">Just A Rather Very Intelligent System</p>
            <p class="text-gray-500 text-sm mt-1">by <span class="legacy-logo">Legacy AI</span></p>
        </div>

        <!-- Camera Setup Section -->
        <section id="cameraSection" class="max-w-md mx-auto">
            <div class="glass-card p-8 text-center">
                <div class="mb-6">
                    <div class="w-20 h-20 mx-auto bg-gradient-to-br from-green-500 to-blue-600 rounded-full flex items-center justify-center mb-4">
                        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-white mb-2">Activate JARVIS Assistant</h3>
                    <p class="text-gray-400">Grant camera and microphone access for continuous AI assistance</p>
                </div>
                <button id="startCameraButton" class="w-full bg-gradient-to-r from-green-500 to-blue-600 text-white font-semibold py-4 px-6 rounded-xl hover:from-green-600 hover:to-blue-700 transition-all transform hover:scale-105">
                    <span class="flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h8M3 12h1m0 0v6a2 2 0 002 2h12a2 2 0 002-2v-6m-2 0V9a2 2 0 00-2-2H5a2 2 0 00-2-2v3z"></path>
                        </svg>
                        Initialize JARVIS
                    </span>
                </button>
            </div>
        </section>

        <!-- Main Interface -->
        <section id="interactionSection" class="hidden max-w-lg mx-auto">
            
            <!-- Video Feed -->
            <div class="video-container mb-6 relative">
                <video id="cameraFeed" playsinline autoplay muted></video>
                <div id="motionIndicator" class="motion-indicator"></div>
                <div id="speakingIndicator" class="speaking-indicator">
                    <div class="voice-waveform">
                        <div class="wave-bar"></div>
                        <div class="wave-bar"></div>
                        <div class="wave-bar"></div>
                        <div class="wave-bar"></div>
                        <div class="wave-bar"></div>
                    </div>
                    <span>JARVIS Speaking</span>
                </div>
            </div>

            <!-- Analysis Mode Tabs -->
            <div class="glass-card p-6 mb-6">
                <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                    <span class="w-2 h-2 bg-gradient-to-r from-green-500 to-blue-600 rounded-full"></span>
                    Analysis Mode
                </h3>
                <div class="tab-container">
                    <button id="manualModeButton" class="tab-button">Manual</button>
                    <button id="intervalModeButton" class="tab-button">Auto</button>
                    <button id="motionModeButton" class="tab-button">Motion</button>
                    <button id="wakeWordModeButton" class="tab-button active">Wake Word</button>
                </div>
                <p id="modeDescription" class="text-sm text-gray-400 text-center">Say "Hey JARVIS" to interact</p>
            </div>

            <!-- Voice Settings (Collapsible) -->
            <div class="collapsible-section">
                <div class="collapsible-header" id="voiceToggle">
                    <div class="flex items-center gap-3">
                        <span class="text-lg">🎭</span>
                        <span class="font-semibold text-white">JARVIS Voice Settings</span>
                    </div>
                    <svg class="chevron w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </div>
