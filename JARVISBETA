                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                        <p>Please configure your API keys to activate JARVIS...</p>
                    </div>
                `;
            } else {
                console.log("Valid API key found, hiding modal");
                geminiApiKeyInput.value = '••••••••••••••••';
                if (elevenLabsApiKey) {
                    elevenLabsApiKeyInput.value = '••••••••••••••••';
                }
                apiKeyModal.classList.add('hidden');
                geminiResponseText.innerHTML = `
                    <div class="text-center text-gray-500 py-8">
                        <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>
                        </svg>
                        <p>Good evening, Sir. I'm ready to assist you...</p>
                    </div>
                `;
            }
        }

        function handleSaveApiKeys() {
            const inputGeminiKey = geminiApiKeyInput.value.trim();
            const inputElevenLabsKey = elevenLabsApiKeyInput.value.trim();
            const inputWakeWord = wakeWordInput.value.trim() || 'Hey JARVIS';
            
            if (!inputGeminiKey || inputGeminiKey === '••••••••••••••••' || inputGeminiKey.length < 10) {
                showStatusFloat("Please enter a valid Gemini API key", 5000);
                return;
            }
            
            geminiApiKey = inputGeminiKey;
            elevenLabsApiKey = inputElevenLabsKey;
            wakeWord = inputWakeWord;
            
            localStorage.setItem('geminiApiKey', geminiApiKey);
            if (elevenLabsApiKey) {
                localStorage.setItem('elevenLabsApiKey', elevenLabsApiKey);
            }
            localStorage.setItem('wakeWord', wakeWord);
            
            apiKeyModal.classList.add('hidden');
            showStatusFloat("JARVIS initialized successfully!", 3000);
            
            geminiResponseText.innerHTML = `
                <div class="text-center text-gray-500 py-8">
                    <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>
                    </svg>
                    <p>Good evening, Sir. I'm ready to assist you...</p>
                </div>
            `;
            
            if (analysisMode === 'wakeword') {
                updateWakeWordText();
            }
        }

        async function startCamera() {
            try {
                showStatusFloat("Initializing JARVIS systems...", 2000);
                
                // Get permissions for both camera and microphone at once to prevent multiple permission prompts
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: "environment",
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    },
                    audio: true
                });
                
                mediaStream = stream;
                cameraFeed.srcObject = stream;
                await cameraFeed.play();
                
                isCameraOn = true;
                isMicOn = true;
                speechPermissionGranted = true;
                micPermissionAsked = true;  // Mark that permission has been granted
                
                cameraSection.classList.add('hidden');
                interactionSection.classList.remove('hidden');
                
                showStatusFloat("JARVIS systems online", 3000);
                
                // Initialize audio after camera is active
                initializeAudio();
                
                // Force audio unlock on camera start (critical for iOS)
                if ('webkitAudioContext' in window || 'AudioContext' in window) {
                    // Create and immediately use audio context with user gesture
                    const tempContext = new (window.AudioContext || window.webkitAudioContext)();
                    const tempOsc = tempContext.createOscillator();
                    tempOsc.connect(tempContext.destination);
                    tempOsc.start(0);
                    tempOsc.stop(0.001);
                    
                    // Also create a temporary utterance to unlock speech synthesis
                    if ('speechSynthesis' in window) {
                        const tempUtterance = new SpeechSynthesisUtterance('');
                        speechSynthesis.speak(tempUtterance);
                    }
                }
                
                // Reset recognition attempt counter to ensure we can start fresh
                recognitionAttemptsCount = 0;
                
                if (analysisMode === 'wakeword') {
                    setTimeout(() => {
                        startContinuousListening();
                    }, 1000);
                }
                
                setTimeout(() => {
                    lastFrameData = captureFrameForMotionDetection();
                }, 2000);
                
                updatePermissionStatus();
                
            } catch (err) {
                console.error("Error accessing camera/microphone:", err);
                let errorMessage = "Failed to access camera/microphone. ";
                
                if (err.name === 'NotAllowedError') {
                    errorMessage += "Please allow camera and microphone permissions.";
                } else if (err.name === 'NotFoundError') {
                    errorMessage += "No camera or microphone found.";
                } else {
                    errorMessage += "Please check your device settings.";
                }
                
                showStatusFloat(errorMessage, 7000);
            }
        }

        // New improved AI interaction function
        async function handleAIInteraction(userPrompt = "", isAutomatic = false) {
            if (isAnalyzing) return;
            
            isAnalyzing = true;
            
            try {
                // Initialize audio if not already done
                initializeAudio();
                
                // Stop current audio immediately for faster response
                if (currentAudio) {
                    currentAudio.pause();
                    currentAudio = null;
                    isSpeaking = false;
                    speakingIndicator.classList.remove('active');
                }
                
                if ('speechSynthesis' in window) {
                    speechSynthesis.cancel();
                }
                
                showStatusFloat("Processing...", 1000);
                
                // Determine if we need visual analysis
                const needsVision = shouldUseVision(userPrompt);
                
                let imageData = null;
                if (needsVision && isCameraOn) {
                    imageData = captureSnapshot();
                }
                
                // Create the appropriate prompt
                let fullPrompt = JARVIS_SYSTEM_PROMPT;
                
                if (userPrompt) {
                    fullPrompt += `\n\nUser: "${userPrompt}"`;
                    
                    if (needsVision && imageData) {
                        fullPrompt += "\n\nI have provided an image of what I can currently see. Please analyze it as relevant to the user's request.";
                    } else if (!needsVision) {
                        fullPrompt += "\n\nThis is a general conversation - no visual analysis needed.";
                    }
                } else {
                    fullPrompt += "\n\nGreet the user briefly and ask how you can assist them.";
                }
                
                // Send to Gemini (with or without image)
                const response = await sendToGemini(imageData, fullPrompt);
                
                if (response) {
                    // Keep responses concise for faster speech
                    const trimmedResponse = trimResponse(response);
                    displayResponse(trimmedResponse);
                    
                    // Start speech immediately (non-blocking)
                    textToSpeech(trimmedResponse);
                    
                    responseCount++;
                } else {
                    throw new Error("No response from Gemini");
                }
                
            } catch (error) {
                console.error("AI interaction error:", error);
                const errorMessage = "My apologies, Sir. I encountered a technical difficulty.";
                displayResponse(errorMessage);
                textToSpeech(errorMessage);
                showStatusFloat(`Error: ${error.message}`, 5000);
            } finally {
                isAnalyzing = false;
            }
        }

        // Determine if visual analysis is needed
        function shouldUseVision(prompt) {
            if (!prompt) return false;
            
            const visionKeywords = [
                'see', 'look', 'show', 'what', 'describe', 'analyze', 'view', 
                'camera', 'image', 'picture', 'visual', 'observe', 'watch',
                'room', 'scene', 'environment', 'around', 'here', 'this'
            ];
            
            const lowerPrompt = prompt.toLowerCase();
            return visionKeywords.some(keyword => lowerPrompt.includes(keyword));
        }

        // Trim responses for faster speech
        function trimResponse(response) {
            // Keep responses under 100 words for faster speech
            const words = response.split(' ');
            if (words.length > 100) {
                return words.slice(0, 100).join(' ') + '...';
            }
            return response;
        }

        function captureSnapshot() {
            if (!isCameraOn || !cameraFeed.videoWidth) {
                return null;
            }
            
            const context = snapshotCanvas.getContext('2d');
            snapshotCanvas.width = cameraFeed.videoWidth;
            snapshotCanvas.height = cameraFeed.videoHeight;
            
            context.drawImage(cameraFeed, 0, 0);
            
            return snapshotCanvas.toDataURL('image/jpeg', 0.8);
        }

        async function sendToGemini(imageData, prompt) {
            if (!geminiApiKey) {
                throw new Error("Gemini API key not configured");
            }
            
            try {
                const parts = [{ text: prompt }];
                
                // Add image only if provided
                if (imageData) {
                    const base64Data = imageData.split(',')[1];
                    parts.push({
                        inline_data: {
                            mime_type: "image/jpeg",
                            data: base64Data
                        }
                    });
                }
                
                const requestBody = {
                    contents: [{ parts: parts }],
                    generationConfig: {
                        temperature: 0.9,
                        topK: 40,
                        topP: 0.95,
                        maxOutputTokens: 200, // Reduced for faster responses
                    }
                };
                
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${geminiApiKey}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(requestBody)
                });
                
                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({}));
                    throw new Error(`Gemini API error: ${response.status} - ${errorData.error?.message || response.statusText}`);
                }
                
                const data = await response.json();
                
                if (data.candidates && data.candidates[0] && data.candidates[0].content) {
                    return data.candidates[0].content.parts[0].text;
                } else {
                    throw new Error("Unexpected response format from Gemini");
                }
                
            } catch (error) {
                console.error("Gemini API error:", error);
                throw error;
            }
        }

        // Modified improved textToSpeech function with mobile fixes
        async function textToSpeech(text) {
            if (!text.trim()) return;
            
            try {
                isSpeaking = true;
                speakingIndicator.classList.add('active');
                
                // Force audio initialization on speech attempt
                const audioReady = initializeAudio();
                
                // Always try to resume audio context (critical for mobile)
                if (audioContext && audioContext.state === 'suspended') {
                    try {
                        await audioContext.resume();
                        console.log("Audio context resumed before speech");
                    } catch (e) {
                        console.error("Failed to resume audio context:", e);
                    }
                }
                
                console.log("Starting speech synthesis for:", text.substring(0, 50) + "...");
                
                if ('speechSynthesis' in window) {
                    // Cancel any existing speech
                    window.speechSynthesis.cancel();
                    
                    // Create a new utterance
                    const utterance = new SpeechSynthesisUtterance(text);
                    
                    // Important: Set these before assigning voice
                    utterance.volume = 1.0;
                    utterance.rate = 1.0;
                    utterance.pitch = 1.0;
                    
                    // Get available voices synchronously for iOS compatibility
                    const voices = window.speechSynthesis.getVoices();
                    
                    // If no voices yet, wait briefly and try again (for mobile)
                    if (voices.length === 0) {
                        await new Promise(resolve => setTimeout(resolve, 50));
                        const retryVoices = window.speechSynthesis.getVoices();
                        if (retryVoices.length > 0) {
                            console.log("Retrieved voices on second attempt");
                        }
                    }
                    
                    // Voice selection logic (same as before)
                    let selectedVoice = null;
                    const voicePreferences = [
                        (v) => v.lang.includes('en-GB') && v.name.toLowerCase().includes('male'),
                        (v) => v.lang.includes('en-GB'),
                        (v) => v.name.toLowerCase().includes('british'),
                        (v) => v.name.toLowerCase().includes('daniel'),
                        (v) => v.name.toLowerCase().includes('arthur'),
                        (v) => v.lang.includes('en-US') && v.name.toLowerCase().includes('male'),
                        (v) => v.lang.includes('en-'),
                        (v) => v.default
                    ];
                    
                    for (const preference of voicePreferences) {
                        selectedVoice = voices.find(preference);
                        if (selectedVoice) break;
                    }
                    
                    if (selectedVoice) {
                        utterance.voice = selectedVoice;
                    }
                    
                    // Mobile workaround: Split into smaller chunks if text is long
                    if (text.length > 100 && /iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
                        const sentences = text.split(/(?<=[.!?])\s+/);
                        const utterances = [];
                        
                        let currentText = "";
                        for (const sentence of sentences) {
                            if (currentText.length + sentence.length < 100) {
                                currentText += sentence + " ";
                            } else {
                                if (currentText) utterances.push(currentText);
                                currentText = sentence + " ";
                            }
                        }
                        if (currentText) utterances.push(currentText);
                        
                        // Add each utterance to the queue
                        utterances.forEach((txt, i) => {
                            const utt = new SpeechSynthesisUtterance(txt);
                            utt.voice = selectedVoice;
                            utt.volume = 1.0;
                            utt.rate = 1.0;
                            utt.pitch = 1.0;
                            
                            // Only end speaking on the last utterance
                            if (i === utterances.length - 1) {
                                utt.onend = () => {
                                    isSpeaking = false;
                                    speakingIndicator.classList.remove('active');
                                };
                            }
                            
                            window.speechSynthesis.speak(utt);
                        });
                    } else {
                        // Standard approach for shorter text
                        utterance.onend = () => {
                            isSpeaking = false;
                            speakingIndicator.classList.remove('active');
                        };
                        
                        window.speechSynthesis.speak(utterance);
                    }
                    
                    // Force restart if speech doesn't begin (iOS workaround)
                    setTimeout(() => {
                        if (window.speechSynthesis.paused) {
                            window.speechSynthesis.resume();
                        }
                    }, 500);
                    
                } else {
                    throw new Error("Speech synthesis not available");
                }
                
            } catch (error) {
                console.error("Text-to-speech error:", error);
                isSpeaking = false;
                speakingIndicator.classList.remove('active');
                showStatusFloat("Speech synthesis failed: " + error.message, 5000);
            }
        }

        function displayResponse(text) {
            geminiResponseText.innerHTML = `
                <div class="bg-rgba-76-175-80-0.1 border border-rgba-76-175-80-0.3 rounded-lg p-4 mb-4">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="w-2 h-2 bg-green-400 rounded-full"></span>
                        <span class="text-sm font-semibold text-green-400">JARVIS Response #${responseCount + 1}</span>
                        <span class="text-xs text-gray-500">${new Date().toLocaleTimeString()}</span>
                    </div>
                    <div class="text-gray-200 leading-relaxed">${formatResponse(text)}</div>
                </div>
            `;
            
            const responseContainer = document.getElementById('responseContainer');
            responseContainer.scrollTop = responseContainer.scrollHeight;
        }

        function formatResponse(text) {
            return text
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/\n\n/g, '</p><p>')
                .replace(/\n/g, '<br>')
                .replace(/^/, '<p>')
                .replace(/$/, '</p>');
        }

        // Keyboard shortcuts
        document.addEventListener('keydown', (e) => {
            if (e.key.toLowerCase() === 'c' && !isAnalyzing && analysisMode === 'manual') {
                handleAIInteraction("analyze what you see");
            }
            
            if (e.key.toLowerCase() === 'm') {
                toggleMicrophone();
            }
            
            if (e.key.toLowerCase() === 'v') {
                toggleCamera();
            }
            
            if (e.key.toLowerCase() === 't') {
                testAudio();
            }
            
            if (e.code === 'Space' && isSpeaking) {
                e.preventDefault();
                if (currentAudio) {
                    currentAudio.pause();
                    currentAudio = null;
                } else if ('speechSynthesis' in window) {
                    speechSynthesis.cancel();
                }
                isSpeaking = false;
                speakingIndicator.classList.remove('active');
            }
        });

        // Error handling
        window.addEventListener('error', (e) => {
            console.error('Global error:', e.error);
            showStatusFloat("System error detected. Please refresh if issues persist.", 5000);
        });

        // Page visibility changes - IMPROVED to prevent repeated prompts
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                if (analysisMode === 'wakeword' && isListeningActive) {
                    stopContinuousListening();
                }
            } else {
                // Only restart if we're in wake word mode, mic is on, permissions granted,
                // and we haven't hit the attempt limit
                if (analysisMode === 'wakeword' && isMicOn && speechPermissionGranted && 
                    micPermissionAsked && recognitionAttemptsCount < 3) {
                    
                    setTimeout(() => {
                        if (analysisMode === 'wakeword' && isMicOn && !isListeningActive && 
                            micPermissionAsked) {
                            startContinuousListening();
                        }
                    }, 1000);
                }
            }
        });

        // Cleanup on unload
        window.addEventListener('beforeunload', () => {
            if (mediaStream) {
                mediaStream.getTracks().forEach(track => track.stop());
            }
            if (currentAudio) {
                currentAudio.pause();
            }
            if (recognition && isListeningActive) {
                recognition.stop();
            }
            if ('speechSynthesis' in window) {
                speechSynthesis.cancel();
            }
        });

        // Initialize the application
        document.addEventListener('DOMContentLoaded', initializeApp);

        // Debug functions
        window.JARVIS = {
            chat: (message) => handleAIInteraction(message),
            analyzeNow: () => handleAIInteraction("analyze what you see"),
            toggleMic: toggleMicrophone,
            toggleCam: toggleCamera,
            setMode: setAnalysisMode,
            testAudio: testAudio,
            getStatus: () => ({
                camera: isCameraOn,
                microphone: isMicOn,
                listening: isListeningActive,
                mode: analysisMode,
                speaking: isSpeaking,
                audioInitialized: audioInitialized,
                apiKey: geminiApiKey ? 'Set' : 'Not set'
            }),
            resetRecognition: () => {
                recognitionAttemptsCount = 0;
                if (analysisMode === 'wakeword' && isMicOn && !isListeningActive) {
                    startContinuousListening();
                }
            }
        };
    </script>
