        let intervalId = null;
        let lastFrameData = null;
        let isAnalyzing = false;
        let responseCount = 0;
        let isSpeaking = false;
        let currentAudio = null;
        let availableVoices = [];
        let lastSpeechTime = 0;
        let lastRecognitionRestartTime = 0;  // Track last time we restarted recognition
